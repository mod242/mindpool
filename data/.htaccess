# mindpool – zweite Schutzschicht für das Datenverzeichnis.
# Verhindert direkten Zugriff auf JSON-Dateien, auch falls die Haupt-.htaccess
# durch AllowOverride None unwirksam wäre.

# Apache 2.4+
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2 / mod_access_compat
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
